{
  "name": "tailwind-benchmark-desktop",
  "productName": "Benchmark tailwind.reviews",
  "version": "0.1.1",
  "description": "Desktop agent for the tailwind.reviews market benchmark. Reads your invoices or payments on your computer and sends only rounded ratios.",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "tailwind-benchmark-core": "0.1.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "reviews.tailwind.benchmark",
    "productName": "Benchmark tailwind.reviews",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "tailwind-benchmark-${version}-${os}-${arch}.${ext}"
  },
  "author": "Tailwind Reviews LLC <support@tailwind.reviews>"
}
